// Combines spilled, loop-mutated values with a 6-argument call (2 of
// them stack-passed). This exact combination caught a real bug: stack
// arguments were being read from their original registers *after* the
// register arguments had already been popped into edx/ecx/esi, which
// overlap the general register pool and could silently clobber a
// stack-bound argument that hadn't been read yet.
fn sub6(a: i32, b: i32, c: i32, d: i32, e: i32, f: i32) -> i32 {
    return a - b - c - d - e - f;
}

fn main() -> i32 {
    let v1: i32 = 1;
    let v2: i32 = 2;
    let v3: i32 = 3;
    let v4: i32 = 4;
    let v5: i32 = 5;
    let v6: i32 = 6;
    let v7: i32 = 100;

    let i: i32 = 0;
    while (i < 3) {
        v1 = v1 + 1;
        i = i + 1;
    }

    return sub6(v7, v1, v2, v3, v4, v5) - v6;
}
