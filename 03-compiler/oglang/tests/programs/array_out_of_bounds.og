// Negative test: indexing past the end of a 3-element array must trap
// (process exit 101) rather than silently reading whatever memory
// happens to sit past the array — real bounds checking, not just a
// type-checker restriction that stops at compile time.
fn main() -> i32 {
    let arr: i32[3];
    arr[0] = 1;
    arr[1] = 2;
    arr[2] = 3;

    return arr[5];
}
