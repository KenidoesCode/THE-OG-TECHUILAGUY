// Exercises stack-passed arguments: the first 4 arrive in registers,
// the remaining 2 must be read back from the caller's stack at the
// right offset. Subtraction (not addition) makes this order-sensitive:
// swapping any two arguments would change the result.
fn sub6(a: i32, b: i32, c: i32, d: i32, e: i32, f: i32) -> i32 {
    return a - b - c - d - e - f;
}

fn main() -> i32 {
    return sub6(100, 1, 2, 3, 4, 5);
}
