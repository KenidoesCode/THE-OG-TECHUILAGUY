# Every hosted test script under */tests/ builds its own
# `<name>_test_bin` (or `_tests_bin`) binary in place; tools/verify_all.sh
# cleans these up after a run, but ignore the whole pattern too so a
# script run standalone, or a run interrupted before cleanup, never
# leaves an untracked binary that could get committed by accident.
*_bin
